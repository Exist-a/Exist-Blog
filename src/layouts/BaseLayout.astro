---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

const SITE_NAME = 'Exist Blog';
const DEFAULT_TITLE = 'Exist 的 AI 全栈学习笔记';
const DEFAULT_DESCRIPTION =
  'Exist 的个人技术博客，记录前端、后端、数据库、AI 等方向的学习笔记。';
const AUTHOR = 'Exist';
const DEFAULT_OG_IMAGE = 'avatar.jpg'; // 相对于 base path

interface Props {
  title?: string;
  description?: string;
  /** og:type，不传默认 website；文章页传 article */
  ogType?: 'website' | 'article';
  /** 文章发布时间 ISO 字符串（ogType=article 时使用） */
  publishedTime?: string;
  /** 文章更新时间 ISO 字符串（ogType=article 时使用），不传 fallback 到 publishedTime */
  modifiedTime?: string;
  /** 文章分类（如 "前端 / 后端 / 数据库"），仅 article */
  section?: string;
  /** 文章 tags，用于 og:article:tag（每个 tag 一个 meta） */
  tags?: string[];
  /** 自定义 og:image 路径（相对 base path），不传用默认头像 */
  ogImage?: string;
  /** 百度站长平台验证 token；存在则渲染 <meta name="baidu-site-verification"> */
  baiduSiteVerification?: string;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  ogImage,
  baiduSiteVerification,
} = Astro.props;

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

// Canonical：与 sitemap / GitHub Pages 的 trailingSlash=always 保持一致（都带尾斜杠）。
// 旧版会 .replace(/\/+$/, '') 把尾斜杠去掉，跟 sitemap 不一致 → Google 把信号都打折。
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// og:image 必须是绝对 URL。传入值允许是绝对 URL 或相对 base 的路径
const ogImageAbs = ogImage
  ? (ogImage.startsWith('http')
      ? ogImage
      : new URL(BASE.replace(/\/$/, '') + '/' + ogImage.replace(/^\//, ''), Astro.site).toString())
  : new URL(BASE.replace(/\/$/, '') + '/' + DEFAULT_OG_IMAGE, Astro.site).toString();

// RSS feed 绝对 URL（无论 base 是子路径还是根都有用）
const rssUrl = new URL(BASE + 'rss.xml', Astro.site).toString();
---

<!DOCTYPE html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <!--
      网站图标：优先用 SVG，浏览器不支持时回退到 ICO。
      旧版写死成 avatar.jpg 是个 bug —— 现在改回 public/ 里真正的 favicon。
    -->
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="alternate icon" type="image/x-icon" href={`${BASE}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- RSS feed：让 RSS 采集站、订阅器能自动发现 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={rssUrl}
    />

    <!-- Canonical：避免被识别为重复内容 -->
    <link rel="canonical" href={canonical} />

    <!-- 百度站长平台验证（可选，由调用方传 token） -->
    {baiduSiteVerification && (
      <meta name="baidu-site-verification" content={baiduSiteVerification} />
    )}

    <!-- 移动浏览器 UI 配色：让顶部状态栏跟随主题色 -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && (modifiedTime ?? publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
    )}
    {ogType === 'article' && section && (
      <meta property="article:section" content={section} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content={AUTHOR} />
    )}
    {ogType === 'article' && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <title>{title}</title>

    <!--
      主题初始化：放在 head 顶端，避免刷新时白屏闪一下浅色再切深色
      默认浅色；用户手动选过的写 localStorage('theme')
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main class="shell">
      <slot />
    </main>
  </body>
</html>